# Copy to .env. Docker Compose reads it; ./run.sh setup appends ARTIFACTORY_TOKEN.
# Inside the containers, host.docker.internal is the Docker host (dev Artifactory).
ARTIFACTORY_URL=http://host.docker.internal:8082/artifactory
# ARTIFACTORY_TOKEN=
# Comma-separated subset of docker,maven,npm,pypi,helm,generic (default: all).
# AUT_FORMATS=maven,generic
# Only needed if the token's subject is not /users/<name>:
# ARTIFACTORY_USER=
# Dev setup only; Artifactory's initial admin credentials:
# ARTIFACTORY_ADMIN_USER=admin
# ARTIFACTORY_ADMIN_PASSWORD=password
# Reserved, forwarded to all clients:
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
